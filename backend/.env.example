# Hemlock 环境配置
# 复制此文件为 .env 并修改对应值

# ===== 基础配置 =====
HEMLOCK_DEBUG=true

# ===== 数据库 =====
# 默认存储在 ~/.hemlock/hemlock.db
# HEMLOCK_DB_PATH=C:\Users\YourName\.hemlock\hemlock.db

# ===== API 服务 =====
HEMLOCK_API_HOST=127.0.0.1
HEMLOCK_API_PORT=9876

# ===== 代理服务 =====
HEMLOCK_PROXY_HOST=127.0.0.1
HEMLOCK_PROXY_PORT=8080

# ===== 授权目标范围 =====
# 逗号分隔的域名/通配符，空则允许全部（仅用于安全提醒，不强制拦截）
# HEMLOCK_TARGET_SCOPE=example.com,*.example.com

# ===== 请求限速 =====
HEMLOCK_RATE_LIMIT_PER_SECOND=10

# ===== LLM 配置 =====
# 支持 OpenAI / DeepSeek / 任何 OpenAI 兼容接口
HEMLOCK_LLM_PROVIDER=deepseek
HEMLOCK_LLM_API_KEY=your-api-key-here
HEMLOCK_LLM_BASE_URL=https://api.deepseek.com/v1
HEMLOCK_LLM_MODEL=deepseek-v4-flash

# DeepSeek 配置示例（deepseek-v4-flash=非思考模式，deepseek-v4-flash 思考模式用 thinking 参数切换）:
# HEMLOCK_LLM_API_KEY=sk-xxxxxxxxxxxx
# HEMLOCK_LLM_BASE_URL=https://api.deepseek.com/v1
# HEMLOCK_LLM_MODEL=deepseek-v4-flash

# OpenAI 配置示例:
# HEMLOCK_LLM_API_KEY=sk-xxxxxxxxxxxx
# HEMLOCK_LLM_BASE_URL=https://api.openai.com/v1
# HEMLOCK_LLM_MODEL=gpt-4o-mini
